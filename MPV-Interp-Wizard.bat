@echo off
chcp 65001 >nul 2>&1
setlocal enabledelayedexpansion
title MPV Interpolation Wizard
echo.
echo  MPV Interpolation Wizard - Extrayendo...
echo.

set "TMPDIR=%TEMP%\mpv-interp-wizard"
set "MPV_INTERP_HOME=%~dp0"
set "B64FILE=%TMPDIR%\payload.b64"
set "ZIPFILE=%TMPDIR%\payload.zip"

if exist "%TMPDIR%" rmdir /s /q "%TMPDIR%"
mkdir "%TMPDIR%"

:: Write Base64 payload to file (chunked to avoid CMD line length limit)
echo. > "%B64FILE%"
<nul set /p="" > "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"
<nul set /p="" >> "%B64FILE%"

:: Decode Base64 and extract ZIP via PowerShell
set "PS_CMD=powershell"
where pwsh >nul 2>&1 && set "PS_CMD=pwsh"

:: Write extraction script (avoids escaping issues with inline commands)
set "EXTRACTOR=%TMPDIR%\extract.ps1"
> "%EXTRACTOR%" echo $d = $env:TEMP + '\mpv-interp-wizard'
>> "%EXTRACTOR%" echo $b64 = Get-Content (Join-Path $d 'payload.b64') -Raw
>> "%EXTRACTOR%" echo $bytes = [Convert]::FromBase64String($b64.Trim())
>> "%EXTRACTOR%" echo $zip = Join-Path $d 'payload.zip'
>> "%EXTRACTOR%" echo [IO.File]::WriteAllBytes($zip, $bytes)
>> "%EXTRACTOR%" echo Expand-Archive -Path $zip -DestinationPath $d -Force
>> "%EXTRACTOR%" echo Remove-Item (Join-Path $d 'payload.b64'), $zip -Force -EA SilentlyContinue

%PS_CMD% -NoProfile -ExecutionPolicy Bypass -File "%EXTRACTOR%"

if not exist "%TMPDIR%\mpv-interp-wizard.ps1" (
    echo [ERROR] Fallo la extraccion. Intenta ejecutar como administrador.
    pause
    exit /b 1
)

echo  Iniciando wizard...
echo.

:: Run the wizard
%PS_CMD% -NoProfile -ExecutionPolicy Bypass -File "%TMPDIR%\mpv-interp-wizard.ps1"

:: Cleanup
rmdir /s /q "%TMPDIR%" 2>nul
endlocal